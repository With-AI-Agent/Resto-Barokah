# ============================================================================
# CONTOH berkas pengaturan — SALIN jadi `.env` lalu isi nilainya.
# Berkas `.env` TIDAK ikut ke Git (lihat .gitignore) dan tidak boleh dikirim
# lewat chat. Isi hanya dua nilai publik di bawah; kunci rahasia disimpan di
# panel rahasia Cloudflare / Supabase, bukan di sini.
# Sumber daftar: docs/TECH_SPEC.md bagian 6.
# ============================================================================

# --- boleh dibaca aplikasi (untuk publik; keamanan dijaga RLS) --------------
# Alamat proyek Supabase, bentuk: https://xxxxx.supabase.co
VITE_SUPABASE_URL=

# Kunci publik (anon) proyek Supabase
VITE_SUPABASE_ANON_KEY=

# --- RAHASIA: jangan pernah ditaruh di berkas ini ---------------------------
# Baris di bawah sengaja dikosongkan dan TIDAK memakai awalan VITE_ supaya
# tidak pernah ikut dibundel ke aplikasi. Tempatnya: Cloudflare Secrets
# (untuk Edge Function) dan panel Supabase (untuk kunci Auth).
#
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# BREVO_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CLOUDFLARE_API_TOKEN=
# DENYUT_URL=
